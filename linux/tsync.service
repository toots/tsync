[Unit]
Description=tsync FUSE filesystem
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/tsync start
ExecStop=%h/.local/bin/tsync stop
Restart=on-failure
RestartSec=5
# A stop takes at most about ten seconds: what is still in flight then is
# owed on disk and resumes at the next start.
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=default.target
