; Linux only: macOS has its own menu bar app, and would be linking a library it
; never calls. The libdbus dependency is confined to tray/dbus, which is why
; this is its own opam package -- see dune-project.

(library
 (flags
  (:standard
   -open
   Tsync_dbus
   -open
   Tsync_core
   -open
   Tsync_core_lwt
   -open
   Tsync_conf_parsing
   -open
   Tsync_runtime
   -open
   Tsync_menu))
 (name tsync_tray)
 (modules sni dbusmenu tray_poll tray)
 (enabled_if
  (= %{system} linux))
 (libraries
  tsync_dbus
  tsync-libs.menu
  tsync-libs.core
  tsync-libs.core_lwt
  tsync-libs.conf_parsing
  tsync_runtime
  yojson
  lwt
  lwt.unix
  unix))

(executable
 (flags
  (:standard -open Tsync_tray -open Tsync_core))
 (name main)
 (modules main)
 (public_name tsync-tray)
 (package tsync-tray)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_tray tsync-libs.core cmdliner))
