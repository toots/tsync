opam-version: "2.0"
synopsis: "Cloud-backed filesystem sync tool"
maintainer: ["Romain Beauxis <toots@rastageeks.org>"]
authors: ["Romain Beauxis <toots@rastageeks.org>"]
license: "MIT"
homepage: "https://github.com/toots/tsync"
bug-reports: "https://github.com/toots/tsync/issues"
depends: [
  "ocaml" {>= "5.1"}
  "tsync-libs" {= version}
  "tsync-fuse" {os = "linux"}
  "dune" {>= "3.23"}
  "cmdliner"
  "odoc" {with-doc}
]
# The frontend and backend aggregators are built here, so their (select ...) is
# re-asked on every build of this package: installing one of these and
# rebuilding tsync is what links it in.
depopts: ["tsync-s3" "tsync-android"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
available: os = "linux" | os = "macos"
