<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).refresh</string>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER).camera</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>TsyncAppGroup</key>
    <string>$(TSYNC_APP_GROUP)</string>
    <key>TsyncAppID</key>
    <string>$(TSYNC_APP_ID)</string>
    <!-- ios-app.md §6: the Camera app hands a scanned code to tsync. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER).otpauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>otpauth</string>
            </array>
        </dict>
    </array>
    <!-- 10 §5.6: the vault's ciphers are not the system's. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <true/>
    <key>ITSEncryptionExportComplianceCode</key>
    <string>$(TSYNC_EXPORT_COMPLIANCE_CODE)</string>
    <key>TsyncCommit</key>
    <string>$(TSYNC_COMMIT)</string>
    <key>TsyncDevelopment</key>
    <string>$(TSYNC_DEVELOPMENT)</string>
    <key>TsyncTestServerURL</key>
    <string>$(TSYNC_TEST_SERVER_URL)</string>
    <key>TsyncTestServerSecret</key>
    <string>$(TSYNC_TEST_SERVER_SECRET)</string>
</dict>
</plist>
