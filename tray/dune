; The menu's strings and its icon are decided by [Tray_model] alone, which knows
; nothing about D-Bus. It is the half worth pinning in a test, and pinning it on
; a machine that has no tray -- the macOS runner -- is the point: this menu is a
; copy of the one in macos/TsyncApp, and a divergence should fail there.

(library
 (name tsync_tray_model)
 (modules tray_model))

; Linux only: macOS has its own menu bar app, and would be linking a library it
; never calls. The libdbus dependency is confined to tray/dbus, which is why
; this is its own opam package -- see dune-project.

(library
 (flags
  (:standard
   -open
   Tsync_dbus
   -open
   Tsync_ipc
   -open
   Tsync_conf_parsing
   -open
   Tsync_runtime
   -open
   Tsync_log
   -open
   Tsync_tray_model))
 (name tsync_tray)
 (modules sni dbusmenu tray_poll tray)
 (enabled_if
  (= %{system} linux))
 (libraries
  tsync_dbus
  tsync_tray_model
  tsync_ipc
  tsync_conf_parsing
  tsync_runtime
  tsync_log
  yojson
  lwt
  lwt.unix
  unix))

(executable
 (flags
  (:standard -open Tsync_tray -open Tsync_log))
 (name main)
 (modules main)
 (public_name tsync-tray)
 (package tsync-tray)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_tray tsync_log cmdliner))
