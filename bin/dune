; tsync_catalog links every driver and frontend this build has.

(library
 (name tsync_cli)
 (wrapped false)
 (modules
  (:standard \ tsync tsyncd))
 (libraries
  cmdliner
  tsync_core
  tsync_store
  tsync_config
  tsync_catalog
  tsync_ipc
  tsync_owner
  tsync_vault
  base64
  tsync_domain
  tsync_gc
  tsync_remote
  tsync_sync
  tsync_supervisor
  tsync_status
  tsync_http
  tsync_http_proxy
  qrc
  unix
  yojson
  (select
   platform.ml
   from
   (tsync_secret_service tsync_logind tsync_polkit -> platform.linux.ml)
   (-> platform.none.ml))))

(executable
 (name tsync)
 (public_name tsync)
 (package tsync)
 (modules tsync)
 (libraries tsync_cli))

(executable
 (name tsyncd)
 (modules tsyncd)
 (enabled_if
  (= %{os_type} Win32))
 (link_flags
  (-cclib "-subsystem windows"))
 (libraries tsync_cli))
