opam-version: "2.0"
maintainer: ["Romain Beauxis <toots@rastageeks.org>"]
authors: ["Romain Beauxis <toots@rastageeks.org>"]
license: "MIT"
homepage: "https://github.com/toots/tsync"
bug-reports: "https://github.com/toots/tsync/issues"
dev-repo: "git+https://github.com/toots/tsync.git"
synopsis: "Link preview images for tsync share links, made with FFmpeg"
depends: [
  "dune" {>= "3.17"}
  "ffmpeg-av" {>= "2.0.0"}
  "ffmpeg-avcodec"
  "ffmpeg-avfilter"
  "ffmpeg-avutil"
  "ffmpeg-swscale"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
