opam-version: "2.0"
maintainer: ["Romain Beauxis <toots@rastageeks.org>"]
authors: ["Romain Beauxis <toots@rastageeks.org>"]
license: "MIT"
homepage: "https://github.com/toots/tsync"
bug-reports: "https://github.com/toots/tsync/issues"
dev-repo: "git+https://github.com/toots/tsync.git"
synopsis: "Synchronise folders through object stores"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {>= "3.17"}
  "base64"
  "cmdliner"
  "digestif"
  "domain-name"
  "eqaf"
  "mem_usage"
  "mirage-crypto-pk"
  "ppx_deriving_yojson"
  "ptime"
  "re"
  "x509"
  "yojson"
  "odoc" {with-doc}
  # One TLS implementation is required. Native comes first: it builds
  # anywhere, where OpenSSL is faster but wants a system libssl. With both,
  # OpenSSL is the default and `tsync start --tls` chooses.
  ("tsync-tls" | "tsync-ssl")
]
# Each rebuilds tsync when it appears, which links its library in. The TLS
# libraries stand for their packages, which may not appear in both lists.
depopts: ["tsync-fuse" "tls" "ssl"]
conflicts: [
  "fuse3" {< "3.10.0.1"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
