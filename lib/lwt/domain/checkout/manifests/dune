; The manifest mirror on Lwt: what the store published for a file and what this
; client staged over it, read off this process's filesystem.

(library
 (flags
  (:standard
   -open
   Tsync_conf
   -open
   Tsync_manifests
   -open
   Tsync_staged_lwt
   -open
   Tsync_cache_layout_lwt
   -open
   Tsync_io_lwt))
 (name tsync_manifests_lwt)
 (public_name tsync-libs.manifests_lwt)
 (libraries
  tsync_conf
  tsync_manifests
  tsync_staged_lwt
  tsync_cache_layout_lwt
  tsync_io_lwt
  lwt))
