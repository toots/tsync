; The retry loop of tsync-libs.retry, bound to Lwt. Apart from it so that the
; vocabulary every caller shares -- what a failure is, whether it will clear --
; links no scheduler.

(library
 (flags
  (:standard -open Tsync_retry -open Tsync_io_lwt))
 (name tsync_retry_lwt)
 (public_name tsync-libs.retry_lwt)
 (libraries tsync_retry tsync_io_lwt lwt))
