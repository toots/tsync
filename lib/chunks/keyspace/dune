; Where a chunk lives in a store, and the objects a store keeps about one: the
; shard it is filed under, the requests asking a store to check or drop chunks,
; and the markers recording what it found. Below the drivers, because a driver
; places a chunk and an object store writes the requests.

(library
 (flags
  (:standard -open Tsync_chunks -open Tsync_bigstring -open Tsync_lwt_unix))
 (name tsync_chunk_keyspace)
 (public_name tsync-libs.chunk_keyspace)
 (libraries tsync_chunks tsync_bigstring tsync_lwt_unix yojson lwt))
