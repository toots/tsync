   -open
   Tsync_chunks
   -open
   Tsync_manifest
   -open
   Tsync_journal
   -open
   Tsync_conf
   -open
   Tsync_naming
   -open
   Tsync_bigstring
   -open
   Tsync_backend_register
   -open
   Tsync_local_io
   -open
   Tsync_lwt_unix
   -open
   Tsync_log))
 (name tsync_store)
 (public_name tsync-libs.store)
 (libraries
  tsync_retry
  tsync_logical_key
  tsync_chunk_integrity
  tsync_chunks
  tsync_manifest
  tsync_journal
  tsync_conf
  tsync_naming
  tsync_bigstring
