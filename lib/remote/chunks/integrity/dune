 (flags
  (:standard -open Tsync_chunks -open Tsync_bigstring -open Tsync_lwt_unix))
 (name tsync_chunk_integrity)
 (public_name tsync-libs.chunk_integrity)
 (libraries tsync_chunks tsync_bigstring tsync_lwt_unix yojson lwt))
