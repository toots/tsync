; The same binding with libdbus resolved by dlopen (dbus_dlopen.h), for the
; tsync binary, whose package declares no bus library (linux-desktop §6.3).

(copy_files# ../dbus.{ml,mli})

(copy_files ../dbus_{stubs.c,dlopen.h})

(rule
 (targets c_flags.sexp)
 (enabled_if
  (= %{system} linux))
 (action
  (with-stdout-to
   c_flags.sexp
   (system "echo \"($(pkg-config --cflags dbus-1))\""))))

(library
 (name tsync_dbus_dl)
 (enabled_if
  (= %{system} linux))
 (libraries unix)
 (foreign_stubs
  (language c)
  (names dbus_stubs)
  (extra_deps dbus_dlopen.h)
  (flags
   :standard
   -DTSYNC_DBUS_DLOPEN
   (:include c_flags.sexp)))
 (c_library_flags -ldl))
