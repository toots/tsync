; The lifecycle of a command that is not a daemon. Its own library rather than
; part of one it would otherwise be linked with: the drain it owes belongs to
; whoever runs an operation, not to whoever builds the domain it runs against.

(library
 (flags
  (:standard
   -open
   Tsync_log
   -open
   Tsync_job_report_lwt
   -open
   Tsync_backend_lwt))
 (name tsync_oneshot)
 (libraries
  tsync_log
  tsync_job_report_lwt
  tsync_backend_lwt
  memtrace
  unix
  lwt
  lwt.unix))
