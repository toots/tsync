   -open
   Tsync_xxhash
   -open
   Tsync_metrics
   -open
   Tsync_bigstring
   -open
   Tsync_backend_register
   -open
   Tsync_log))
 (name tsync_content)
 (public_name tsync-libs.content)
 (libraries
