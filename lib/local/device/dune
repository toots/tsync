; Per-OS, on the model of lib/platform/runtime: each platform builds only its own
; implementation, and the dispatcher selects between them. A platform with no
; implementation would answer [None] everywhere, which callers already handle as
; "no opinion" — see device.mli.

(library
 (name tsync_linux_device)
 (public_name tsync-libs.linux_device)
 (enabled_if
  (= %{system} linux))
 (modules linux_device)
 (flags
  (:standard -open Tsync_stdlib -open Tsync_io))
 (foreign_stubs
  (language c)
  (names linux_clone_stubs))
 (libraries tsync_stdlib unix tsync-libs.io tsync_io))

(library
 (name tsync_macos_device)
 (public_name tsync-libs.macos_device)
 (enabled_if
  (= %{system} macosx))
 (modules macos_device)
 (flags
  (:standard -open Tsync_io))
 (foreign_stubs
  (language c)
  (names macos_clone_stubs))
 (libraries unix tsync-libs.io tsync_io))

; [descriptors] and [watch] are not per-OS in the way [device] is: both are one
; C file with the platform branch inside it, because what differs is which
; syscalls name the idea rather than the idea. They live here because they are
; the same kind of fact as [device] — something the platform imposes or offers,
; discovered at runtime by asking rather than looked up per target.

(library
 (name tsync_device)
 (public_name tsync-libs.device)
 (modules device descriptors watch)
 (foreign_stubs
  (language c)
  (names descriptors_stubs watch_stubs))
 (libraries
  unix
  tsync_io
  (select
   device.ml
   from
   (tsync_linux_device -> device.linux.ml)
   (tsync_macos_device -> device.macos.ml))))
