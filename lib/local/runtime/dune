(library
 (name tsync_linux_runtime)
 (public_name tsync-libs.linux_runtime)
 (enabled_if
  (= %{system} linux))
 (modules linux_runtime))

(library
 (name tsync_macos_runtime)
 (flags
  (:standard -open Tsync_stdlib))
 (enabled_if
  (= %{system} macosx))
 (modules macos_runtime)
 (libraries tsync_stdlib))

(library
 (name tsync_runtime)
 (modules runtime)
 (libraries
  (select
   runtime.ml
   from
   (tsync_linux_runtime -> runtime.linux.ml)
   (tsync_macos_runtime -> runtime.macos.ml))))
