; vault §2.3: the EFF large word list, eff.org/dice, by the Electronic Frontier
; Foundation under CC BY 3.0 US; SHA-256 addd3553…996b903e as fetched.

(rule
 (targets eff_large_wordlist.ml)
 (deps
  (:list eff_large_wordlist.txt))
 (action
  (with-stdout-to
   eff_large_wordlist.ml
   (progn
    (echo "let text = {tsync_asset|")
    (cat %{list})
    (echo "|tsync_asset}\n")))))

(library
 (name tsync_vault)
 (libraries
  tsync_core
  yojson
  base64
  digestif
  mirage-crypto-ec
  mirage-crypto-rng.unix)
 (foreign_stubs
  (language c)
  (include_dirs ../../vendor/monocypher)
  (names vault_stubs)))

; §7.3: the Public Suffix List snapshot, embedded as Psl_data.text.

(rule
 (target psl_data.ml)
 (deps public_suffix_list.dat)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let text = {psl|")
    (cat public_suffix_list.dat)
    (echo "|psl}\n")))))
