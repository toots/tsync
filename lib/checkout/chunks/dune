; The checkout's chunk bodies: a run of a file's chunks kept as one local file.
; Everything here is re-fetchable, which is what lets the cap delete by age
; alone. Its own library so the staged tree can publish into it without the
; checkout's overlay closing a cycle.

(library
 (flags
  (:standard
   -open
   Tsync_manifest
   -open
   Tsync_conf
   -open
   Tsync_naming
   -open
   Tsync_chunks
   -open
   Tsync_io_lwt
   -open
   Tsync_backend_register
   -open
   Tsync_bigstring
   -open
   Tsync_log))
 (name tsync_chunk_cache)
 (public_name tsync-libs.chunk_cache)
 (libraries
  tsync_manifest
  tsync_conf
  tsync_naming
  tsync_chunks
  tsync_io_lwt
  tsync_backend_register
  tsync_bigstring
  tsync_log
  lwt
  unix
  lwt.unix))
