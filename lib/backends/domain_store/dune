; One write fanned across the backends a domain is configured with, and a
; durable record of what an unreachable one still owes. Composed from drivers
; and presented as one, so it knows how bytes are stored and never what the
; domain does with them.

(library
 (flags
  (:standard -open Tsync_core -open Tsync_backend_register -open Tsync_io))
 (name tsync_domain_store)
 (public_name tsync-libs.domain_store)
 (libraries
  tsync-libs.core
  tsync_core
  tsync_io
  tsync_backend_register
  yojson))
