; Every storage driver this build can talk to, linked together so a config can
; name one. A backend sees lib/model and lib/utils and nothing else in the tree:
; it knows how bytes are stored and found, never what the domain does with them.

(library
 (name tsync_backend)
 (libraries
  tsync_local_backend_lwt
  tsync_http_proxy_backend_lwt
  tsync_gcs_backend_lwt
  (select
   s3_link.ml
   from
   (tsync_s3_backend_lwt -> s3_link.enabled.ml)
   (-> s3_link.disabled.ml))))
