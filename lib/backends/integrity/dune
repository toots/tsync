; How chunks are handled by each backend: the requests a store is asked to run
; over its chunks, and the markers recording what it found. Beside the drivers
; rather than in the model because nothing local reads any of it — a driver
; writes these, and collection and the CLI read them back.

(library
 (flags
  (:standard -open Tsync_core -open Tsync_io))
 (name tsync_chunk_integrity)
 (public_name tsync-libs.chunk_integrity)
 (libraries tsync-libs.core tsync_core tsync_io yojson))
