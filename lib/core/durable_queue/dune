; A queue whose records outlive the process that made them: a job is on disk
; before its caller is told, and a start reads back what the last one left.

(library
 (flags
  (:standard
   -open
   Tsync_stdlib
   -open
   Tsync_io
   -open
   Tsync_metrics
   -open
   Tsync_log
   -open
   Tsync_retry))
 (name tsync_durable_queue)
 (public_name tsync-libs.durable_queue)
 (libraries tsync_stdlib tsync_retry tsync_metrics tsync_log tsync_io unix))
