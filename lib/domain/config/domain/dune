; Where a configured role becomes behaviour. Above the stores it composes and
; below everything that runs against one, so a test can build a real domain
; without linking a daemon.

(library
 (flags
  (:standard
   -open
   Tsync_stdlib
   -open
   Tsync_logical_key
   -open
   Tsync_manifest
   -open
   Tsync_chunks
   -open
   Tsync_conf_lwt
   -open
   Tsync_conf_parsing
   -open
   Tsync_backend_register
   -open
   Tsync_backend_lwt
   -open
   Tsync_domain_store
   -open
   Tsync_domain_store_lwt
   -open
   Tsync_field_spec
   -open
   Tsync_runtime))
 (name tsync_domain)
 (libraries
  tsync_stdlib
  tsync_logical_key
  tsync_manifest
  tsync_chunks
  tsync_conf_lwt
  tsync_conf_parsing
  tsync_backend_register
  tsync_backend_lwt
  tsync_domain_store
  tsync_domain_store_lwt
  tsync_field_spec
  tsync_runtime))
