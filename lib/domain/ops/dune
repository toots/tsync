; One-shot jobs over a whole domain: import, export, expire, gc, mirror, remote
; mirror, share. Applications of the layers below rather than an abstraction of
; their own -- nothing depends on this library, which is what lets each of these
; run without a daemon.

(library
 (flags
  (:standard
   -open
   Tsync_cache_layout
   -open
   Tsync_checkout
   -open
   Tsync_remote
   -open
   Tsync_io
   -open
   Tsync_core
   -open
   Tsync_chunk_integrity
   -open
   Tsync_manifest
   -open
   Tsync_journal
   -open
   Tsync_conf
   -open
   Tsync_sync
   -open
   Tsync_backend_register))
 (name tsync_ops)
 (public_name tsync-libs.ops)
 (libraries
  tsync_cache_layout
  tsync_checkout
  tsync_remote
  tsync_io
  tsync_core
  tsync_chunk_integrity
  tsync_manifest
  tsync_journal
  tsync_conf
  tsync_sync
  tsync_backend_register
  yojson
  unix))
