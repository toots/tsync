; Bytes to and from a manifest: chunking and dedup on the way out, the local
; cache-chunk store, and demand-paged range reads on the way back. A file is
; never assembled -- a read maps its byte range onto the chunks backing it and
; fetches only the ones that are absent.

(library
 (flags
  (:standard
   -open
   Tsync_logical_key
   -open
   Tsync_staged
   -open
   Tsync_chunk_cache
   -open
   Tsync_manifest
   -open
   Tsync_conf
   -open
   Tsync_cache_layout
   -open
   Tsync_chunks
   -open
   Tsync_io
   -open
   Tsync_bigstring
   -open
   Tsync_backend_register
   -open
   Tsync_log))
 (name tsync_content)
 (public_name tsync-libs.content)
 (libraries
  tsync_logical_key
  tsync_staged
  tsync_chunk_cache
  tsync_manifest
  tsync_conf
  tsync_cache_layout
  tsync_chunks
  tsync_io
  tsync_bigstring
  tsync_backend_register
  tsync_log
  unix))
