; linkall: the frontend registers itself when linked.

(library
 (name tsync_http_proxy)
 (library_flags (-linkall))
 (libraries
  tsync_core
  tsync_config
  tsync_store
  tsync_http
  tsync_http_proxy_client
  tsync_domain
  tsync_remote
  tsync_ipc
  tsync_owner
  tsync_status
  tsync_setup_link
  unix
  base64
  digestif
  mirage-crypto-ec
  mirage-crypto-rng.unix
  x509
  yojson))

(rule
 (targets share_assets.ml)
 (deps
  (:browse %{project_root}/lambda/browse.html)
  (:player %{project_root}/lambda/player.js)
  (:card %{project_root}/lambda/share-card.png))
 (action
  (with-stdout-to
   share_assets.ml
   (progn
    (echo "let browse = {tsync_asset|")
    (cat %{browse})
    (echo "|tsync_asset}\nlet player = {tsync_asset|")
    (cat %{player})
    (echo "|tsync_asset}\nlet card_base64 = \"")
    (system "base64 < %{card} | tr -d '\\r\\n'")
    (echo "\"\n")))))

(rule
 (targets status_page.ml)
 (deps
  (:page status_page.html))
 (action
  (with-stdout-to
   status_page.ml
   (progn
    (echo "let html = {tsync_page|")
    (cat %{page})
    (echo "|tsync_page}\n")))))

(rule
 (targets setup_assets.ml)
 (deps
  (:page setup_page.html)
  (:qrcode %{project_root}/vendor/qrcode-generator/qrcode.js))
 (action
  (with-stdout-to
   setup_assets.ml
   (progn
    (echo "let html = {tsync_asset|")
    (cat %{page})
    (echo "|tsync_asset}\nlet qrcode = {tsync_asset|")
    (cat %{qrcode})
    (echo "|tsync_asset}\n")))))
