; One-shot jobs over a whole domain: import, export, expire, gc, mirror, remote
; mirror, share. Applications of the layers below rather than an abstraction of
; their own -- nothing depends on this library, which is what lets each of these
; run without a daemon.

(library
 (flags
  (:standard
   -open
   Tsync_conf
   -open
   Tsync_naming
   -open
   Tsync_object
   -open
   Tsync_store
   -open
   Tsync_content
   -open
   Tsync_sync
   -open
   Tsync_local_io
   -open
   Tsync_lwt_unix
   -open
   Tsync_glob
   -open
   Tsync_chunk
   -open
   Tsync_hashtbl_mmap
   -open
   Tsync_backend_register
   -open
   Tsync_log))
 (name tsync_ops)
 (public_name tsync-libs.ops)
 (libraries
  tsync_conf
  tsync_naming
  tsync_object
  tsync_store
  tsync_content
  tsync_sync
  tsync_local_io
  tsync_lwt_unix
  tsync_glob
  tsync_chunk
  tsync_hashtbl_mmap
  tsync_backend_register
  tsync_log
  bigstringaf
  yojson
  unix
  lwt
  lwt.unix))
