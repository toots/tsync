#!/bin/bash
# Runs as root after the app is placed in /Applications.
set -e

APP=/Applications/TsyncApp.app

# The daemon doubles as the CLI. /usr/local/bin is in the default PATH from
# /etc/paths but does not exist on a clean install.
mkdir -p /usr/local/bin
ln -sf "$APP/Contents/MacOS/tsync" /usr/local/bin/tsync

# Everything else belongs to the console user, not root: the LaunchAgent, the
# login item and the File Provider domains are all per-user.
console_uid=$(stat -f %u /dev/console)
console_user=$(stat -f %Su /dev/console)
if [ -z "$console_uid" ] || [ "$console_uid" = "0" ]; then
    exit 0
fi

launchctl asuser "$console_uid" sudo -u "$console_user" \
    "$APP/Contents/Resources/install-agent.sh" "$APP" || true
launchctl asuser "$console_uid" sudo -u "$console_user" open -a "$APP" || true

exit 0
