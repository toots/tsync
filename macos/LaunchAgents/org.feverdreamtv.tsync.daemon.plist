<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.feverdreamtv.tsync.daemon</string>
    <!-- Resolved against the enclosing app bundle by SMAppService. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/tsync</string>
    <key>ProgramArguments</key>
    <array>
        <string>tsync</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- stdout/stderr land in the unified log: log stream --process tsync -->
</dict>
</plist>
