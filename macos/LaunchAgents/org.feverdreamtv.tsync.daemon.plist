<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.feverdreamtv.tsync.daemon</string>
    <!-- Resolved against the enclosing app bundle by SMAppService. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/tsync</string>
    <key>ProgramArguments</key>
    <array>
        <string>tsync</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on a crash, but respect a clean exit: the daemon exits 0 when
         there is no config yet, which happens on every fresh install. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- stdout/stderr land in the unified log: log stream --process tsync -->
</dict>
</plist>
