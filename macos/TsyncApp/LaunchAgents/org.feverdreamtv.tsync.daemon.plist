<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- file-provider §11: the service's agent, defined inside the bundle and
     registered by the app through SMAppService. Restarted on any unclean exit;
     the service keeps running with no domain, so a clean exit is a stop. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.feverdreamtv.tsync.daemon</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/tsync</string>
    <key>ProgramArguments</key>
    <array>
        <string>tsync</string>
        <string>start</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>org.feverdreamtv.tsync</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
