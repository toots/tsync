<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- extractNativeLibs: without it nativeLibraryDir points inside the APK and
         there is no file on disk to exec. Pairs with useLegacyPackaging in the
         build script; both are required. -->
    <application
        android:label="tsync"
        android:extractNativeLibs="true"
        android:icon="@android:drawable/stat_notify_sync">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DaemonService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
