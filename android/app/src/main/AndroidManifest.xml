<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- extractNativeLibs: without it nativeLibraryDir points inside the APK and
         there is no file on disk to exec. Pairs with useLegacyPackaging in the
         build script; both are required. -->
    <application
        android:label="tsync"
        android:extractNativeLibs="true"
        android:icon="@android:drawable/stat_notify_sync">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DaemonService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- MANAGE_DOCUMENTS is held by the system only, so this is reachable
             through the picker rather than by arbitrary apps. -->
        <provider
            android:name=".TsyncProvider"
            android:authorities="org.feverdreamtv.tsync.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>
</manifest>
