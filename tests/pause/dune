(executable
 (flags
  (:standard
   -open
   Tsync_sync
   -open
   Tsync_object
   -open
   Tsync_local_io
   -open
   Tsync_backend_register
   -open
   Tsync_conf
   -open
   Tsync_local_backend))
 (name pause_test)
 (libraries
  tsync_sync
  tsync_object
  tsync_conf
  tsync_backend_register
  tsync_local_backend
  tsync_local_io
  lwt
  lwt.unix))

(alias
 (name default)
 (deps pause_test.exe))

(rule
 (alias runtest)
 (target pause_test.output)
 (action
  (with-stdout-to
   pause_test.output
   (ignore-stderr
    (run ./pause_test.exe)))))

(rule
 (alias runtest)
 (action
  (diff pause_test.expected pause_test.output)))
