(executable
 (name bridge_test)
 (modules bridge_test)
 (foreign_stubs
  (language c)
  (include_dirs ../../lib/frontends/android/jni)
  (names stress_stubs))
 (libraries
  test_support
  tsync_core
  tsync_catalog
  tsync_android
  tsync_android_bridge
  threads.posix
  unix
  yojson))

(rule
 (with-stdout-to
  bridge_test.output
  (run ./bridge_test.exe %{exe:../../bin/tsync.exe})))

(rule
 (alias runtest-android)
 (action
  (diff bridge_test.expected bridge_test.output)))

