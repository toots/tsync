(executable
 (flags
  (:standard
   -open
   Tsync_content
   -open
   Tsync_object
   -open
   Tsync_naming
   -open
   Tsync_xxhash
   -open
   Tsync_backend_register
   -open
   Tsync_conf))
 (name chunk_cache_test)
 (libraries
  tsync_content
  tsync_object
  tsync_naming
  tsync_xxhash
  tsync_conf
  tsync_backend_register
  lwt
  lwt.unix))

(alias
 (name default)
 (deps chunk_cache_test.exe))

(rule
 (alias runtest)
 (target chunk_cache_test.output)
 (action
  (with-stdout-to
   chunk_cache_test.output
   (ignore-stderr
    (run ./chunk_cache_test.exe)))))

(rule
 (alias runtest)
 (action
  (diff chunk_cache_test.expected chunk_cache_test.output)))
