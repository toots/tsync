(executable
 (name http_proxy_test)
 (libraries
  tsync_http_proxy
  tsync_backend_register
  tsync_local_backend
  tsync_http_proxy_backend
  tsync_frontend_register
  tsync_frontend
  tsync_diagnostics
  tsync_conf
  tsync_local_io
  cohttp
  yojson
  lwt
  lwt.unix
  uri))

(alias
 (name default)
 (deps http_proxy_test.exe))

; The report stamps its recent errors in local time, which is what someone
; reading their own server wants and what makes the snapshot depend on the
; machine that ran it. Pinned here so the recorded times are the same
; everywhere.

(rule
 (alias runtest)
 (target http_proxy_test.output)
 (action
  (with-stdout-to
   http_proxy_test.output
   (ignore-stderr
    (setenv
     TZ
     UTC
     (run ./http_proxy_test.exe))))))

(rule
 (alias runtest)
 (action
  (diff http_proxy_test.expected http_proxy_test.output)))
