== a share that is gone has its site removed (security §6.5)
GET f -> 404 location - cache-control - content-type text/plain; charset=utf-8
  site f: absent
GET 7 -> 410 location - cache-control - content-type text/plain; charset=utf-8
  site 7: absent
== a share that cannot be read keeps its site
GET 8 -> 502 location - cache-control - content-type text/plain; charset=utf-8
  site 8/index.html 3 bytes 644
== revoking asks the link, which removes the site
revoke a: done
  site a: absent
record left: false
create site --site: done
