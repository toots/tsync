(library
 (name contract)
 (modules contract)
 (libraries tsync_core tsync_store unix))

(executable
 (name local_test)
 (modules local_test)
 (libraries contract tsync_core tsync_store unix yojson))

(rule
 (with-stdout-to
  local_test.output
  (run ./local_test.exe)))

(rule
 (alias runtest)
 (action
  (diff local_test.expected local_test.output)))

(executable
 (name composite_test)
 (modules composite_test)
 (libraries contract tsync_core tsync_store unix))

(rule
 (with-stdout-to
  composite_test.output
  (run ./composite_test.exe)))

(rule
 (alias runtest)
 (action
  (diff composite_test.expected composite_test.output)))

(executable
 (name gcs_test)
 (modules gcs_test)
 (libraries
  contract
  tsync_core
  tsync_store
  tsync_gcs
  tsync_http
  unix
  yojson
  ptime
  base64))

; The CI variables select a real bucket; they are dependencies, so a cached
; run against the fake is never replayed as a real one.

(rule
 (deps
  (env_var TSYNC_CI_GCS_BUCKET)
  (env_var TSYNC_CI_GCS_SERVICE_ACCOUNT_KEY)
  (env_var TSYNC_CI_REQUIRE_REAL))
 (action
  (with-stdout-to
   gcs_test.output
   (run ./gcs_test.exe))))

(rule
 (alias runtest)
 (action
  (diff gcs_test.expected gcs_test.output)))
