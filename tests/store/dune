; Which library sources know the collection exists (gc.md §5.8, §10 "Scoped
; access"): a new name in this list is a caller that learned about GC.

(rule
 (deps
  (source_tree %{workspace_root}/lib))
 (action
  (with-stdout-to
   gc_scoping.output
   (system
    "cd %{workspace_root}/lib && grep -rlE 'Key\\.(chunks_from|chunk_from|gc_run|gc_lock|gc_generation|outgoing_chunk|outgoing_prefix|is_outgoing)|Gc_generation\\.|Chunk_spaces\\.' --include='*.ml' --exclude-dir=.formatted . | sort"))))

(rule
 (alias runtest)
 (action
  (diff gc_scoping.expected gc_scoping.output)))

(executable
 (name watch_test)
 (modules watch_test)
 (libraries tsync_core tsync_store unix))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (with-stdout-to
   watch_test.output
   (run ./watch_test.exe))))

(rule
 (alias runtest)
 (enabled_if
  (= %{system} linux))
 (action
  (diff watch_test.expected watch_test.output)))

; 09 §10.1: reported, not silently skipped, where it cannot run.

(rule
 (alias runtest)
 (enabled_if
  (not
   (= %{system} linux)))
 (action
  (echo "watch_test: not run, no directory watch on this platform\n")))

(executable
 (name s3_test)
 (modules s3_test)
 (libraries
  contract
  tsync_core
  tsync_store
  tsync_s3
  tsync_http
  unix
  ptime
  base64
  digestif))

(rule
 (deps
  (env_var TSYNC_CI_S3_BUCKET)
  (env_var TSYNC_CI_S3_ACCESS_KEY_ID)
  (env_var TSYNC_CI_S3_SECRET_ACCESS_KEY)
  (env_var TSYNC_CI_S3_ENDPOINT)
  (env_var TSYNC_CI_S3_REGION)
  (env_var TSYNC_CI_REQUIRE_REAL))
 (action
  (with-stdout-to
   s3_test.output
   (run ./s3_test.exe))))

(rule
 (alias runtest)
 (action
  (diff s3_test.expected s3_test.output)))

