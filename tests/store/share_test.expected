== ranges of a 39-byte file (§A9.5)
(none)           whole
bytes=6-10       bytes 6-10/39
bytes=6-         bytes 6-38/39
bytes=-5         bytes 34-38/39
bytes=-100       bytes 0-38/39
bytes=30-100     bytes 30-38/39
bytes=39-        416
bytes=10-6       whole
bytes=1-2,4-5    whole
bytes=+1-2       whole
items=1-2        whole
bytes=-0         whole
== content-disposition (security §13)
attachment; filename="report.pdf"; filename*=UTF-8''report.pdf
inline; filename="a_b_c ____.txt"; filename*=UTF-8''a%22b%5Cc%20%E2%9C%93%0A.txt
== files that open the viewer page (§A9.3)
a.MP3        true
a.mp4        true
a.jpg        true
a.pdf        true
a.txt        false
a.html       false
a.json       false
a.bin        false
mp3          false
== routes of a file share (§A9.3)
a1 / -> 200 text/html; charset=utf-8 | - | page: file mode true, raw name false
a1 /f -> 200 audio/mpeg | inline; filename="</script>.mp3"; filename*=UTF-8''%3C%2Fscript%3E.mp3 | 0123456789abcdefXYZ
a1 /f?json=1 -> 200 application/json | - | {"url":"/s/a1/f","name":"</script>.mp3","contentType":"audio/mpeg","size":19}
a1 /download -> 200 audio/mpeg | attachment; filename="</script>.mp3"; filename*=UTF-8''%3C%2Fscript%3E.mp3 | 0123456789abcdefXYZ
a1 /list -> 404 text/plain; charset=utf-8 | - | not found
a2 / -> 200 text/plain; charset=utf-8 | attachment; filename="notes.txt"; filename*=UTF-8''notes.txt | plain words
a2 /f -> 200 text/plain; charset=utf-8 | inline; filename="notes.txt"; filename*=UTF-8''notes.txt | plain words
a3 / -> 404 text/plain; charset=utf-8 | - | not found
