; The Linux keystore against a Secret Service double on a private bus. The
; double links the tray's binding and the test the dlopen one, which define the
; same C symbols, so they are two processes.

(executable
 (name secret_service_double)
 (modules secret_service_double)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_core tsync_dbus tsync_tray_lib))

(executable
 (name secret_service_test)
 (modules secret_service_test)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_core tsync_owner tsync_secret_service unix))

(rule
 (enabled_if
  (= %{system} linux))
 (action
  (with-stdout-to
   secret_service_test.output
   (run ./secret_service_test.exe %{exe:secret_service_double.exe}))))

(rule
 (alias runtest-linux)
 (enabled_if
  (= %{system} linux))
 (action
  (diff secret_service_test.expected secret_service_test.output)))

