########## LISTING ##########
=== files: dirty then clean etag
  write a.txt "hello"
  write b.txt "world"
--- listing
  list_dir root -> {"ok":true,"items":[{"ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt","kind":"file","size":5,"mtime":"<mtime>","etag":"650e58ac64da6e0a","isUploaded":true},{"ref":"f:.tsync-root/b.txt","parentRef":"root","name":"b.txt","kind":"file","size":5,"mtime":"<mtime>","etag":"0c85c7c61d1a6890","isUploaded":true}]}
  list_all root -> {"ok":true,"items":[{"ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt","kind":"file","size":5,"mtime":"<mtime>","etag":"650e58ac64da6e0a","isUploaded":true},{"ref":"f:.tsync-root/b.txt","parentRef":"root","name":"b.txt","kind":"file","size":5,"mtime":"<mtime>","etag":"0c85c7c61d1a6890","isUploaded":true}]}

=== nested directories keyed as full paths
  mkdir sub
  drain
  write sub/c.txt "nested"
  write top.txt "top"
--- listing
  list_dir root -> {"ok":true,"items":[{"ref":"d:<folder-1>","parentRef":"root","name":"sub","kind":"dir","size":0,"mtime":"<zero>","etag":"<folder-1>","isUploaded":true},{"ref":"f:.tsync-root/top.txt","parentRef":"root","name":"top.txt","kind":"file","size":3,"mtime":"<mtime>","etag":"97bb0a4a6df0d08e","isUploaded":true}]}
  list_dir d:<folder-1> -> {"ok":true,"items":[{"ref":"f:<folder-1>/c.txt","parentRef":"d:<folder-1>","name":"c.txt","kind":"file","size":6,"mtime":"<mtime>","etag":"7546f608548f4d0d","isUploaded":true}]}
  list_all root -> {"ok":true,"items":[{"ref":"f:.tsync-root/top.txt","parentRef":"root","name":"top.txt","kind":"file","size":3,"mtime":"<mtime>","etag":"97bb0a4a6df0d08e","isUploaded":true},{"ref":"f:<folder-1>/c.txt","parentRef":"d:<folder-1>","name":"c.txt","kind":"file","size":6,"mtime":"<mtime>","etag":"7546f608548f4d0d","isUploaded":true}]}

=== a folder this client cannot name is counted, not dropped
  mkdir sub
  drain
  write sub/c.txt "nested"
  write top.txt "top"
  drain
  forget-folder-id sub
--- listing
  list_dir root -> {"ok":true,"items":[{"ref":"f:.tsync-root/top.txt","parentRef":"root","name":"top.txt","kind":"file","size":3,"mtime":"<mtime>","etag":"97bb0a4a6df0d08e","isUploaded":true}],"unnamed":1}
  list_all root -> {"ok":true,"items":[{"ref":"f:.tsync-root/top.txt","parentRef":"root","name":"top.txt","kind":"file","size":3,"mtime":"<mtime>","etag":"97bb0a4a6df0d08e","isUploaded":true}],"unnamed":1}

=== identical content shares an etag
  write x.txt "same bytes"
  drain
  write y.txt "same bytes"
--- listing
  list_dir root -> {"ok":true,"items":[{"ref":"f:.tsync-root/x.txt","parentRef":"root","name":"x.txt","kind":"file","size":10,"mtime":"<mtime>","etag":"83aa3fc9fadd8e79","isUploaded":true},{"ref":"f:.tsync-root/y.txt","parentRef":"root","name":"y.txt","kind":"file","size":10,"mtime":"<mtime>","etag":"83aa3fc9fadd8e79","isUploaded":true}]}
  list_all root -> {"ok":true,"items":[{"ref":"f:.tsync-root/x.txt","parentRef":"root","name":"x.txt","kind":"file","size":10,"mtime":"<mtime>","etag":"83aa3fc9fadd8e79","isUploaded":true},{"ref":"f:.tsync-root/y.txt","parentRef":"root","name":"y.txt","kind":"file","size":10,"mtime":"<mtime>","etag":"83aa3fc9fadd8e79","isUploaded":true}]}

########## PARENT REFS ##########
=== create under a parent named by key
  mkdir sub
  drain
  create bykey.txt under tsync/test/manifests/sub
  create bykey.txt under tsync/test/manifests/sub: ok
--- listing
  list_dir root -> {"ok":true,"items":[{"ref":"d:<folder-1>","parentRef":"root","name":"sub","kind":"dir","size":0,"mtime":"<zero>","etag":"<folder-1>","isUploaded":true}]}
  list_dir d:<folder-1> -> {"ok":true,"items":[{"ref":"f:<folder-1>/bykey.txt","parentRef":"d:<folder-1>","name":"bykey.txt","kind":"file","size":0,"mtime":"<mtime>","etag":"","isUploaded":true}]}
  list_all root -> {"ok":true,"items":[{"ref":"f:<folder-1>/bykey.txt","parentRef":"d:<folder-1>","name":"bykey.txt","kind":"file","size":0,"mtime":"<mtime>","etag":"","isUploaded":true}]}

########## CHANGES ##########
=== foreign put
  A: write a.txt "hi"
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"put","size":2,"ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

=== foreign mkdir then put
  A: mkdir sub
  A: drain
  A: write sub/f.txt "deep"
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"mkdir","id":"<folder-1>","ref":"d:<folder-1>","parentRef":"root","name":"sub"},{"op":"put","size":4,"ref":"f:<folder-1>/f.txt","parentRef":"d:<folder-1>","name":"f.txt"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

=== foreign delete
  A: write a.txt "x"
  A: drain
  A: delete a.txt
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"put","size":1,"ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt"},{"op":"delete","ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

=== foreign rename
  A: write a.txt "x"
  A: drain
  A: rename a.txt -> b.txt
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"put","size":1,"ref":"f:.tsync-root/a.txt","parentRef":"root","name":"a.txt"},{"op":"rename","is_dir":false,"ref":"f:.tsync-root/b.txt","parentRef":"root","name":"b.txt","srcRef":"f:.tsync-root/a.txt"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

=== foreign rmdir carries the folder id
  A: mkdir gone
  A: drain
  A: rmdir gone
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"mkdir","id":"<folder-1>","ref":"d:<folder-1>","parentRef":"root","name":"gone"},{"op":"rmdir","id":"<folder-1>","ref":"d:<folder-1>","parentRef":"root","name":"gone"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

=== foreign dir rename carries the folder id
  A: mkdir before
  A: drain
  A: rename before -> after
  A: drain
--- B changes_since (A's ops are foreign to B)
  changes_since from baseline (working) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[{"op":"mkdir","id":"<folder-1>","ref":"d:<folder-1>","parentRef":"root","name":"before"},{"op":"rename","is_dir":true,"id":"<folder-1>","ref":"d:<folder-1>","parentRef":"root","name":"after","srcRef":"d:<folder-1>"}]}
  changes_since from current (up to date) -> {"ok":true,"stale":false,"cursor":"<cursor>","ops":[]}
  changes_since from pruned anchor (stale) -> {"ok":true,"stale":true}

