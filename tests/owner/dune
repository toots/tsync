(executable
 (name owner_test)
 (modules owner_test)
 (libraries
  tsync_core
  tsync_config
  tsync_catalog
  tsync_ipc
  tsync_owner
  tsync_store
  tsync_remote
  unix
  yojson))

(rule
 (with-stdout-to
  owner_test.output
  (run ./owner_test.exe)))

(rule
 (alias runtest)
 (action
  (diff owner_test.expected owner_test.output)))

(rule
 (alias runtest-serial)
 (action
  (diff owner_test.expected owner_test.output)))

