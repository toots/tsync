(executable
 (flags
  (:standard
   -open
   Tsync_object
   -open
   Tsync_naming
   -open
   Tsync_local_io
   -open
   Tsync_backend_register
   -open
   Tsync_local_backend
   -open
   Tsync_lane_backend))
 (name lane)
 (libraries
  tsync_object
  tsync_naming
  tsync_backend_register
  tsync_lane_backend
  tsync_local_backend
  tsync_local_io
  lwt
  lwt.unix
  unix))

(alias
 (name default)
 (deps lane.exe))

(rule
 (alias runtest)
 (target lane.output)
 (action
  (with-stdout-to
   lane.output
   (ignore-stderr
    (run ./lane.exe)))))

(rule
 (alias runtest)
 (action
  (diff lane.expected lane.output)))
