(executable
 (flags
  (:standard
   -open
   Tsync_content
   -open
   Tsync_object
   -open
   Tsync_backend_register
   -open
   Tsync_conf
   -open
   Tsync_local_backend))
 (name upload)
 (libraries
  tsync_content
  tsync_object
  tsync_conf
  tsync_backend_register
  tsync_local_backend))

(alias
 (name default)
 (deps upload.exe))

(rule
 (alias runtest)
 (target upload.output)
 (action
  (with-stdout-to
   upload.output
   (ignore-stderr
    (run ./upload.exe)))))

(rule
 (alias runtest)
 (action
  (diff upload.expected upload.output)))
