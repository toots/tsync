(executable
 (name plan_test)
 (modules plan_test)
 (libraries tsync_core tsync_store tsync_sync tsync_gc))

(rule
 (with-stdout-to
  plan_test.output
  (run ./plan_test.exe)))

(rule
 (alias runtest)
 (action
  (diff plan_test.expected plan_test.output)))

