(executable
 (flags
  (:standard
   -open
   Tsync_object
   -open
   Tsync_naming
   -open
   Tsync_local_io
   -open
   Tsync_backend_register
   -open
   Tsync_local_backend
   -open
   Tsync_lane_backend))
 (name backfill)
 (libraries
  tsync_object
  tsync_naming
  tsync_backend_register
  tsync_local_io
  tsync_lane_backend
  tsync_local_backend
  lwt
  lwt.unix
  unix))

(alias
 (name default)
 (deps backfill.exe))

(rule
 (alias runtest)
 (target backfill.output)
 (action
  (with-stdout-to
   backfill.output
   (ignore-stderr
    (run ./backfill.exe)))))

(rule
 (alias runtest)
 (action
  (diff backfill.expected backfill.output)))
