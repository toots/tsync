
=== a directory is made, then seen
  mkdir root photos
    {"ok":true,"item":{"ref":"d:<id1>","parentRef":"root","name":"photos","kind":"dir","size":0,"mtime":0.0,"etag":"<id1>","isUploaded":true}}
  list root
    {"ok":true,"items":[{"ref":"d:<id1>","parentRef":"root","name":"photos","kind":"dir","size":0,"mtime":0.0,"etag":"<id1>","isUploaded":true}]}
  stat d:<id1>
    {"ok":true,"ref":"d:<id1>","parentRef":"root","name":"photos","kind":"dir","size":0,"mtime":0.0,"etag":"<id1>","isUploaded":true}
  stat root
    {"ok":true,"ref":"root","parentRef":"root","name":"media","kind":"dir","size":0,"mtime":0.0,"etag":".tsync-root","isUploaded":true}

=== a whole body is adopted by rename
  write-whole d:<id1> big.txt <root>/staged.bin
    {"ok":true,"size":24,"mtime":1400000000.0,"item":{"ref":"f:<id1>/big.txt","parentRef":"d:<id1>","name":"big.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true}}
  staging file still there: false
  stat f:<id1>/big.txt
    {"ok":true,"ref":"f:<id1>/big.txt","parentRef":"d:<id1>","name":"big.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true}

=== ranges, each served by its own process, reassemble the file
  read f:<id1>/big.txt <root>/ranges.bin 0 8
    {"ok":true,"localPath":"<root>/ranges.bin","offset":0,"length":8}
    dest[0,8) = "01234567"
  read f:<id1>/big.txt <root>/ranges.bin 8 8
    {"ok":true,"localPath":"<root>/ranges.bin","offset":8,"length":8}
    dest[8,16) = "89ABCDEF"
  read f:<id1>/big.txt <root>/ranges.bin 16 8
    {"ok":true,"localPath":"<root>/ranges.bin","offset":16,"length":8}
    dest[16,24) = "ghijklmn"
  reassembled = "0123456789ABCDEFghijklmn"
  read f:<id1>/big.txt <root>/mid.bin 4 12
    {"ok":true,"localPath":"<root>/mid.bin","offset":4,"length":12}
    dest[4,16) = "456789ABCDEF"

=== a read past the content is short, never padded
  read f:<id1>/big.txt <root>/tail.bin 16 64
    {"ok":true,"localPath":"<root>/tail.bin","offset":16,"length":8}
    dest[16,24) = "ghijklmn"
  read f:<id1>/big.txt <root>/past.bin 99 8
    {"ok":true,"localPath":"<root>/past.bin","offset":99,"length":0}
    dest[99,99) = ""

=== a reference that is not there is a coded refusal
  stat f:.tsync-root/nope.txt
    {"ok":false,"code":"not_found","error":"not found: tsync/media/manifests/nope.txt"}
  list d:nowhere
    {"ok":false,"code":"not_found","error":"not found: d:nowhere"}
  stat tsync/media/manifests/photos/
    {"ok":false,"code":"not_found","error":"not found: tsync/media/manifests/photos/"}

=== a created file is empty until something is written to it
  create d:<id1> new.txt
    {"ok":true,"item":{"ref":"f:<id1>/new.txt","parentRef":"d:<id1>","name":"new.txt","kind":"file","size":0,"mtime":<clock>,"etag":"","isUploaded":false}}
  stat f:<id1>/new.txt
    {"ok":true,"ref":"f:<id1>/new.txt","parentRef":"d:<id1>","name":"new.txt","kind":"file","size":0,"mtime":<clock>,"etag":"","isUploaded":false}

=== the whole content, assembled into a file for editing in place
  fetch f:<id1>/big.txt <root>/fetched.bin
    {"ok":true,"localPath":"<root>/fetched.bin"}
  fetched = "0123456789ABCDEFghijklmn"

=== what of the file is on this device
  residency f:<id1>/big.txt
    {"ok":true,"cached":3,"total":3}

=== a folder is read a page at a time, resumed by name
  list d:<id1>  1
    {"ok":true,"items":[{"ref":"f:<id1>/big.txt","parentRef":"d:<id1>","name":"big.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true}],"next":"big.txt"}
  list d:<id1> big.txt 1
    {"ok":true,"items":[{"ref":"f:<id1>/new.txt","parentRef":"d:<id1>","name":"new.txt","kind":"file","size":0,"mtime":<clock>,"etag":"","isUploaded":true}]}

=== one request on the wire the app speaks
  request {"action":"stat","ref":"f:<id1>/big.txt"}
    {"ok":true,"ref":"f:<id1>/big.txt","parentRef":"d:<id1>","name":"big.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true}

=== a link where no backend can hold a share
  share f:<id1>/big.txt
    {"ok":false,"code":"internal","error":"Sharing is not available for media."}

=== one process serves every range of an open file
  open {"ok":true,"size":24}
  range 0+8 -> 8 "01234567"
  range 8+8 -> 8 "89ABCDEF"
  range 16+8 -> 8 "ghijklmn"
  range 99+8 -> 0 ""

=== the namespace verbs move and remove
  rename f:<id1>/big.txt d:<id1> moved.txt
    {"ok":true,"item":{"ref":"f:<id1>/moved.txt","parentRef":"d:<id1>","name":"moved.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true}}
  list d:<id1>
    {"ok":true,"items":[{"ref":"f:<id1>/moved.txt","parentRef":"d:<id1>","name":"moved.txt","kind":"file","size":24,"mtime":1400000000.0,"etag":"1294bbe85c2f380b","isUploaded":true},{"ref":"f:<id1>/new.txt","parentRef":"d:<id1>","name":"new.txt","kind":"file","size":0,"mtime":<clock>,"etag":"06b4b04bae2346bf","isUploaded":true}]}
  delete f:<id1>/moved.txt
    {"ok":true}
  delete f:<id1>/new.txt
    {"ok":true}
  rmdir d:<id1>
    {"ok":true}
  list root
    {"ok":true,"items":[]}

=== the report answers with no daemon to ask
  Domain media
  settings         versioning on, symlinks skip, chunk 8 B, cache chunk 8 B
  concurrency      4 uploads, 4 chunk buffers, 8 downloads

=== every verb the frontend registers is driven above
  registered: create delete fetch list mkdir open read rename request residency rmdir share stat status write-whole
  untested:   (none)
