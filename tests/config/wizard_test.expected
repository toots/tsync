? a number to edit that domain, [a]dd, [r]emove N, [g]lobals, [w]rite, [q]uit -> w
edit: would write
{
  "name": "box",
  "links": { "wan": { "maxRate": 1000, "minRate": 200 } },
  "domains": [
    {
      "name": "docs",
      "symlinks": "keep",
      "versioning": true,
      "frontends": [ "http-proxy" ],
      "backends": [
        {
          "type": "local",
          "name": "main",
          "role": "main",
          "path": "/srv/docs"
        },
        {
          "type": "http-proxy",
          "name": "far",
          "role": "replica",
          "link": "wan",
          "url": "https://far.example:5446",
          "secret": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        {
          "type": "local",
          "name": "copy",
          "role": "main",
          "path": "/srv/copy"
        }
      ],
      "maxCache": "2 GiB"
    }
  ]
}

