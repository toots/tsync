(executable
 (name config_test)
 (modules config_test)
 (libraries
  tsync_core
  tsync_config
  tsync_catalog
  tsync_store
  tsync_http_proxy))

(rule
 (with-stdout-to
  config_test.output
  (run ./config_test.exe)))

(rule
 (alias runtest)
 (action
  (diff config_test.expected config_test.output)))

