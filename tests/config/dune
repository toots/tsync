(executable
 (name config_test)
 (modules config_test)
 (libraries
  tsync_core
  tsync_config
  tsync_catalog
  tsync_store
  tsync_http_proxy))

(rule
 (enabled_if %{lib-available:tsync_fuse})
 (action
  (with-stdout-to
   config_test.output
   (run ./config_test.exe))))

(rule
 (alias runtest)
 (enabled_if %{lib-available:tsync_fuse})
 (action
  (diff config_test.expected config_test.output)))

; 09 §10.1: reported, not silently skipped, where it cannot run.

(rule
 (alias runtest)
 (enabled_if
  (not %{lib-available:tsync_fuse}))
 (action
  (echo
   "config_test: not run, its configs name the fuse frontend, not in this build\n")))

