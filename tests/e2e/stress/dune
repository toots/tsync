; Not a `test`: it mounts two filesystems and hammers them. Run by hand with
; `make -C linux stress`, or with TSYNC_STRESS_SEED to replay a failure.

(executable
 (flags
  (:standard -open Tsync_runtime -open Tsync_e2e -open Tsync_object))
 (name stress)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_e2e tsync_runtime tsync_object yojson unix threads.posix))
