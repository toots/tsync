; Not a `test`: it mounts two filesystems and hammers them. Run by hand with
; `make -C linux stress`, or with TSYNC_STRESS_SEED to replay a failure.

(executable
 (flags
  (:standard -open Tsync_manifest -open Tsync_e2e))
 (name stress)
 (enabled_if
  (= %{system} linux))
 (libraries tsync_manifest tsync_e2e yojson unix threads.posix))
