=== a restored file is pinned: spared by the cap and not counted
  write p.txt "pppppppp"
  drain
  write q.txt "qqqqqqqq"
  drain
  write r.txt "rrrrrrrr"
  drain
  evict p.txt
  evict q.txt
  evict r.txt
  restore p.txt
  drain
  read q.txt [0,8)
  drain
  read r.txt [0,8)
  drain
  local? p.txt
  local? q.txt
  chunk-cache
  enforce-cache
  chunk-cache
  chunks p.txt
  chunks q.txt
  chunks r.txt
  evict p.txt
  local? p.txt
  chunk-cache
  read q.txt [0,8) = "qqqqqqqq"
  read r.txt [0,8) = "rrrrrrrr"
  local? p.txt = pinned
  local? q.txt = cached
  chunk-cache chunks=3 bytes=24 pinned=8
  chunk-cache chunks=2 bytes=16 pinned=8
  chunks p.txt published size=8 chunks=1 cached=1/1
  chunks q.txt published size=8 chunks=1 cached=0/1
  chunks r.txt published size=8 chunks=1 cached=1/1
  local? p.txt = online-only
  chunk-cache chunks=1 bytes=8 pinned=0
