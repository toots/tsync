=== a staged file's bodies are never dropped
  write x.txt "xxxxxxxx"
  drain
  evict x.txt
  read x.txt [0,8)
  drain
  stage-write z.txt "zzzzzzzz"
  enforce-cache
  chunks x.txt
  chunks z.txt
  read z.txt [0,8)
  read x.txt [0,8) = "xxxxxxxx"
  chunks x.txt published size=8 chunks=1 cached=1/1
  chunks z.txt staged size=8 slots=[S] cached=1/1
  read z.txt [0,8) = "zzzzzzzz"
