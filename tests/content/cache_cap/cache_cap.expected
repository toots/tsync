=== the sweep drops the coldest bodies; a re-read fetches them back
  write a.txt "aaaaaaaa"
  drain
  write b.txt "bbbbbbbb"
  drain
  write c.txt "cccccccc"
  drain
  evict a.txt
  evict b.txt
  evict c.txt
  read a.txt [0,8)
  drain
  read b.txt [0,8)
  drain
  read c.txt [0,8)
  drain
  chunk-cache
  enforce-cache
  chunk-cache
  chunks a.txt
  chunks b.txt
  chunks c.txt
  read a.txt [0,8)
  chunks a.txt
  read a.txt [0,8) = "aaaaaaaa"
  read b.txt [0,8) = "bbbbbbbb"
  read c.txt [0,8) = "cccccccc"
  chunk-cache chunks=3 bytes=24 pinned=0
  chunk-cache chunks=1 bytes=8 pinned=0
  chunks a.txt published size=8 chunks=1 cached=0/1
  chunks b.txt published size=8 chunks=1 cached=0/1
  chunks c.txt published size=8 chunks=1 cached=1/1
  read a.txt [0,8) = "aaaaaaaa"
  chunks a.txt published size=8 chunks=1 cached=1/1
