=== the count follows what lands in the store, without walking it
  chunk-cache
  write a.txt "aaaaaaaa"
  drain
  evict a.txt
  chunk-cache
  read a.txt [0,8)
  drain
  chunk-cache
  evict a.txt
  chunk-cache
  chunk-cache chunks=0 bytes=0
  chunk-cache chunks=0 bytes=0
  read a.txt [0,8) = "aaaaaaaa"
  chunk-cache chunks=1 bytes=8
  chunk-cache chunks=0 bytes=0
