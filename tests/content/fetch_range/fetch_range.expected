=== a range straddling the end is served short, not padded
  write tail.txt "0123456789ABCDEFghijklmn"
  drain
  evict tail.txt
  fetch-range tail.txt [16,32)
  fetch-range tail.txt [64,72)
  chunks tail.txt
  fetch-range tail.txt [16,32) served=8 file-size=24 = "ghijklmn"
  fetch-range tail.txt [64,72) served=0 file-size=0 = ""
  chunks tail.txt published size=24 chunks=3 cached=1/3
