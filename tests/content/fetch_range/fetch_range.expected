=== ranges covering the file reassemble it
  write cover.txt "0123456789ABCDEFghijklmn"
  drain
  evict cover.txt
  fetch-range cover.txt [0,8)
  fetch-range cover.txt [8,16)
  fetch-range cover.txt [16,24)
  chunks cover.txt
  fetch-range cover.txt [0,8) served=8 file-size=8 = "01234567"
  fetch-range cover.txt [8,16) served=8 file-size=16 = "89ABCDEF"
  fetch-range cover.txt [16,24) served=8 file-size=24 = "ghijklmn"
  chunks cover.txt published size=24 chunks=3 cached=3/3
--- tree
  f cover.txt size=24 cached=3/3 uploaded=true etag=1294bbe85c2f380b
