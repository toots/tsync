=== a chunk deleted under a reader is fetched again
  write gone.txt "0123456789ABCDEFghijklmn"
  drain
  read gone.txt [0,8)
  delete-cached-chunk gone.txt #0
  chunks gone.txt
  read gone.txt [0,8)
  chunks gone.txt
  read gone.txt [0,8) = "01234567"
  chunks gone.txt published size=24 chunks=3 cached=2/3
  read gone.txt [0,8) = "01234567"
  chunks gone.txt published size=24 chunks=3 cached=3/3
