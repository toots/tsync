=== reads fetch only the chunks they touch
  write big.txt "0123456789ABCDEFghijklmn"
  drain
  evict big.txt
  chunks big.txt
  read big.txt [0,8)
  chunks big.txt
  read big.txt [16,24)
  chunks big.txt
  read big.txt [8,16)
  chunks big.txt
  chunks big.txt published size=24 chunks=3 cached=0/3
  read big.txt [0,8) = "01234567"
  chunks big.txt published size=24 chunks=3 cached=1/3
  read big.txt [16,24) = "ghijklmn"
  chunks big.txt published size=24 chunks=3 cached=2/3
  read big.txt [8,16) = "89ABCDEF"
  chunks big.txt published size=24 chunks=3 cached=3/3
