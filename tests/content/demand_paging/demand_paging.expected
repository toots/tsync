=== shrinking into a chunk that is not local fetches just that chunk
  write shrink.txt "0123456789ABCDEFghijklmn"
  drain
  evict shrink.txt
  truncate shrink.txt 4
  chunks shrink.txt
  close shrink.txt
  drain
  read shrink.txt [0,8)
  chunks shrink.txt staged size=4 slots=[S] cached=1/1
  read shrink.txt [0,8) = "0123"
