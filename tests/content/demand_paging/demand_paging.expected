=== a write covering part of a chunk fetches just that chunk
  write rmw.txt "aaaaaaaabbbbbbbbcccccccc"
  drain
  evict rmw.txt
  write-at rmw.txt @10 "XX"
  chunks rmw.txt
  close rmw.txt
  drain
  read rmw.txt [8,16)
  chunks rmw.txt staged size=24 slots=[ISI] cached=1/3
  read rmw.txt [8,16) = "bbXXbbbb"
