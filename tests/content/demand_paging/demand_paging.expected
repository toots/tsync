=== editing one chunk re-uploads only that chunk
  write edit.txt "aaaaaaaabbbbbbbbcccccccc"
  drain
  evict edit.txt
  write-at edit.txt @8 "BBBBBBBB"
  chunks edit.txt
  close edit.txt
  drain
  chunks edit.txt
  read edit.txt [0,24)
  chunks edit.txt
  chunks edit.txt staged size=24 slots=[ISI] cached=1/3
  chunks edit.txt published size=24 chunks=3 cached=1/3
  read edit.txt [0,24) = "aaaaaaaaBBBBBBBBcccccccc"
  chunks edit.txt published size=24 chunks=3 cached=3/3
