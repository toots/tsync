; Each test prints what it checked; the output is compared with a committed
; <name>.expected snapshot, so a change reads as a diff.

(executables
 (names rt_test core_test dqueue_test)
 (modules rt_test core_test dqueue_test)
 (libraries tsync_core unix))

(executables
 (names uplink_test uplink_law_test uplink_modes_test)
 (modules uplink_test uplink_law_test uplink_modes_test)
 (libraries tsync_core tsync_store yojson unix))

(rule
 (with-stdout-to
  uplink_modes_test.output
  (run ./uplink_modes_test.exe)))

(rule
 (alias runtest)
 (action
  (diff uplink_modes_test.expected uplink_modes_test.output)))

(rule
 (with-stdout-to
  uplink_law_test.output
  (run ./uplink_law_test.exe)))

(rule
 (alias runtest)
 (action
  (diff uplink_law_test.expected uplink_law_test.output)))

(rule
 (with-stdout-to
  uplink_test.output
  (run ./uplink_test.exe)))

(rule
 (alias runtest)
 (action
  (diff uplink_test.expected uplink_test.output)))

(rule
 (with-stdout-to
  rt_test.output
