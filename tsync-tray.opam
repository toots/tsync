opam-version: "2.0"
maintainer: ["Romain Beauxis <toots@rastageeks.org>"]
authors: ["Romain Beauxis <toots@rastageeks.org>"]
license: "MIT"
homepage: "https://github.com/toots/tsync"
bug-reports: "https://github.com/toots/tsync/issues"
dev-repo: "git+https://github.com/toots/tsync.git"
synopsis: "Tray icon for tsync on Linux desktops"
depends: [
  "dune" {>= "3.17"}
  "tsync" {= version}
  "cmdliner"
  "conf-dbus"
]
available: os = "linux"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
